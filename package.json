  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "mocha --exit",
    "test:coverage": "nyc --reporter=html --reporter=text mocha --exit",
    "coverage": "yarn test:coverage",
    "lint": "eslint . --ext .js --max-warnings 0",
