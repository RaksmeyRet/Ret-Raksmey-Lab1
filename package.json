    "mocha": "^11.7.4",
    "nyc": "^17.1.0",
    "supertest": "^7.1.4"
  },
  "nyc": {
    "exclude": [
      "test/**",
      "node_modules/**",
      "coverage/**"
    ],
    "reporter": [
      "text",
      "html",
      "lcov"
    ],
    "check-coverage": true,
    "lines": 80,
    "functions": 80,
    "branches": 80,
    "statements": 80
  }
